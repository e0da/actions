{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/e0da/actions/schemas/wiki-verification-policy.v1.schema.json",
  "title": "Wiki verification policy v1",
  "description": "Caller-owned effects and ownership for expected Wiki checks.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "policy_id",
    "policy_version",
    "target",
    "expected_checks"
  ],
  "properties": {
    "contract_version": {
      "const": "wiki-verification-policy.v1"
    },
    "policy_id": {
      "type": "string",
      "minLength": 1
    },
    "policy_version": {
      "type": "string",
      "minLength": 1
    },
    "target": {
      "enum": ["merge", "deploy-preflight"]
    },
    "expected_checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/expectedCheck"
      }
    }
  },
  "$defs": {
    "effect": {
      "enum": ["none", "advisory", "block"]
    },
    "expectedCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check_id",
        "applicability",
        "on_violation",
        "on_partial",
        "on_unavailable",
        "owner",
        "action"
      ],
      "properties": {
        "check_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
        },
        "applicability": {
          "enum": ["required", "optional"]
        },
        "on_violation": {
          "$ref": "#/$defs/effect"
        },
        "on_partial": {
          "$ref": "#/$defs/effect"
        },
        "on_unavailable": {
          "$ref": "#/$defs/effect"
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
